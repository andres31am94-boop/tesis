# Entorno virtual de Python
.venv/
__pycache__/
*.pyc

# Datos y resultados pesados (se regeneran con los scripts)
data/raw/
data/processed/
*.mp4
*.avi

# Pesos de modelos YOLO descargados (se documenta la versión, no se sube el archivo)
*.pt
*.onnx

# Salidas temporales de SUMO
*.log
sumo/**/output/

# Sistema operativo / editores
Thumbs.db
desktop.ini
.vscode/
.idea/

# Capturas de Google Maps/Street View: no se publican en el repo (terminos de uso de Google).
# Se reemplazaran por fotos propias tomadas en campo.
docs/fases/img/streetview_*.png
docs/fases/img/interseccion_mapa.png

# Salidas crudas de SUMO (se regeneran con la misma semilla)
results/**/tripinfo.xml

# Modelos entrenados: se versiona la tabla (pequena) y la curva; nada que excluir por ahora.
results/**/*_tripinfo.xml
# Copias de rutas/configs que genera el barrido de calibracion (se regeneran con el script)
results/calibracion/*/*/*.rou.xml
results/calibracion/*/*/*.sumocfg
results/calibracion/barrido_red/*/*.net.xml
results/calibracion/barrido_red/*/*.sumocfg

# Normativa (documentos oficiales publicos, pesados: el Manual 2024 pesa 44 MB). Se citan en la tesis, no se versionan.
docs/normativa/
# Archivos sueltos de pruebas
tests/*.add

# Entorno aparte de Label Studio y su base de datos local (Fase 7.4)
.venv_label/
data/label_studio/

# Imagenes con cajas sobre FOTOS PROPIAS (salen manos/pies, la casa): se quedan en el PC; se suben solo los resumen.json
results/vision/evaluacion_hotwheels/**/*.jpg
results/vision/prueba_hotwheels/**/*.jpg
results/vision/tracking/**/*.jpg
results/vision/zonas/*.jpg
results/vision/conteo_zonas/**/*.jpg

# Entrenamientos con FOTOS PROPIAS (hotwheels_v2 en adelante): los mosaicos train_batch/val_batch/labels.jpg
# muestran manos, pies y la casa. Se suben solo las curvas (.png), results.csv y el registro.
results/vision/entrenamiento/hotwheels_v2*/**/*.jpg
results/vision/prueba_alturas/**/*.jpg
