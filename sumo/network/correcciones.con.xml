<?xml version="1.0" encoding="UTF-8"?>
<!--
  Correcciones de conexiones (movimientos permitidos en el cruce).
  Fuente: observacion de los autores (2026-10-05).

  1) GIRO A LA IZQUIERDA PROHIBIDO en los 4 brazos: desde cualquier brazo solo se puede
     seguir recto o girar a la derecha. OSM no tiene esa restriccion, por eso netconvert
     habia creado los giros a la izquierda.
  2) Vuelta en U prohibida en la Carrera 23 sur (OSM la dibuja como dos calzadas separadas
     y netconvert no la reconoce como vuelta en U).
  3) Carrera 23 sur, carril interior (indice 1): al quitar el giro a la izquierda quedaba sin
     ningun movimiento. Segun las flechas pintadas en la via, ese carril es para seguir recto.
-->
<connections>
    <!-- 1) Giros a la izquierda prohibidos -->
    <delete from="-642480900"  to="1414166246#0"/>  <!-- Norte (Cra 23) -> Este (Dg 15) -->
    <delete from="816899410#0" to="642480899"/>     <!-- Este (Dg 15)  -> Sur (Cra 23)  -->
    <delete from="807940779"   to="1414166244"/>    <!-- Sur (Cra 23)  -> Oeste (Dg 15) -->
    <delete from="44411778#0"  to="1414166243"/>    <!-- Oeste (Dg 15) -> Norte (Cra 23) -->

    <!-- 2) Vuelta en U prohibida -->
    <delete from="807940779" to="642480899"/>       <!-- Sur (Cra 23) -> Sur (Cra 23) -->

    <!-- 3) Cra 23 sur, recto hacia el puente. Paso 5 de calibracion: la salida tiene 2 carriles hasta el puente,
            asi que cada carril sigue por el suyo (antes: el carril 1 se juntaba con el 0 dentro del cruce). -->
    <connection from="807940779" to="1414166243" fromLane="0" toLane="0"/>
    <connection from="807940779" to="1414166243" fromLane="1" toLane="1"/>

    <!-- 4) Paso 5 de calibracion: la llegada norte tiene 2 carriles junto al cruce (medido). Derecho: giro a la derecha
            y recto; izquierdo: recto. Se mantienen 3 movimientos para este brazo (mismo orden del semaforo). -->
    <connection from="-642480900" to="1414166244" fromLane="0" toLane="0"/>
    <connection from="-642480900" to="642480899" fromLane="0" toLane="0"/>
    <connection from="-642480900" to="642480899" fromLane="1" toLane="1"/>
    <!-- netconvert agrega por su cuenta carril 0 -> carril 1 de la salida; se elimina para que cada carril siga por el suyo -->
    <delete from="-642480900" to="642480899" fromLane="0" toLane="1"/>
</connections>
