<?xml version="1.0" encoding="UTF-8"?>
<!--
  PASO 2 de 3: GEOMETRIA. Aplica a la red importada de OSM los carriles, anchos y tramos medidos en campo.
  Entrada: acacias_osm.net.xml (generada por acacias.netccfg)
  Salida:  acacias_geometria.net.xml (la usa acacias_conexiones.netccfg, paso 3)
  Uso (desde tesis):  netconvert -c sumo\network\acacias_ajustes.netccfg
  Por que en dos pasos: al dividir o cambiar carriles de un tramo, netconvert recalcula sus conexiones y se perdian
  las correcciones de giros (reaparecian los giros a la izquierda). Las conexiones se corrigen en el paso 3.
-->
<configuration>
    <input>
        <sumo-net-file value="acacias_osm.net.xml"/>
        <!-- Calibracion paso 3: nodos de inicio de los tramos de acceso (scripts/generar_accesos.py) -->
        <node-files value="accesos.nod.xml"/>
        <!-- Tramos de acceso de 500 m (primero) + ajustes medidos en campo (despues: pueden modificar los accesos) -->
        <edge-files value="accesos.edg.xml,ajustes.edg.xml"/>
    </input>

    <output>
        <output-file value="acacias_geometria.net.xml"/>
    </output>

    <processing>
        <!-- Conserva las coordenadas de la red aunque los accesos queden en coordenadas negativas -->
        <offset.disable-normalization value="true"/>
        <!-- Sin vueltas en U donde los accesos se unen a los brazos (tampoco las hay en el cruce) -->
        <no-turnarounds value="true"/>
    </processing>

</configuration>
