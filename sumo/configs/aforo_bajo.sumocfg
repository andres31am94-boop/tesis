<?xml version="1.0" encoding="UTF-8"?>
<!-- Escenario REAL generado por scripts/generar_escenarios_aforo.py: Lunes 19-oct, 20:15-21:15 (brazo por brazo, no simultaneo) -->
<configuration>
    <input>
        <net-file value="../network/acacias.net.xml"/>
        <route-files value="../routes/aforo_bajo.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <random_number>
        <seed value="42"/>
    </random_number>
    <report>
        <no-step-log value="true"/>
    </report>
    <processing>
        <!-- Modelo de subcarriles (config/calibracion.yaml): permite a las motos ir lado a lado -->
        <lateral-resolution value="0.7"/>
        <!-- Tiempo maximo trabado antes del teleport (config/calibracion.yaml: subcarriles.tiempo_teleport_s) -->
        <time-to-teleport value="300"/>
    </processing>
</configuration>
